<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="QRAsistencia.MAUI.App">
    <Application.Resources>
        <ResourceDictionary>

            <!-- Paleta de colores -->
            <Color x:Key="BgDark">#0F172A</Color>
            <Color x:Key="Surface">#1E293B</Color>
            <Color x:Key="SurfaceLight">#334155</Color>
            <Color x:Key="Primary">#3B82F6</Color>
            <Color x:Key="PrimaryDark">#2563EB</Color>
            <Color x:Key="Accent">#10B981</Color>
            <Color x:Key="Danger">#EF4444</Color>
            <Color x:Key="TextPrimary">#F8FAFC</Color>
            <Color x:Key="TextSecondary">#94A3B8</Color>
            <Color x:Key="TextMuted">#475569</Color>
            <Color x:Key="Border">#334155</Color>

            <!-- Estilo botón primario -->
            <Style x:Key="BtnPrimary" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="HeightRequest" Value="56" />
                <Setter Property="Shadow">
                    <Setter.Value>
                        <Shadow Brush="{StaticResource Primary}" Offset="0,4" Radius="12" Opacity="0.4" />
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Estilo botón secundario -->
            <Style x:Key="BtnSecondary" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="HeightRequest" Value="56" />
                <Setter Property="BorderColor" Value="{StaticResource Border}" />
                <Setter Property="BorderWidth" Value="1" />
            </Style>

            <!-- Estilo botón danger -->
            <Style x:Key="BtnDanger" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Danger}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="HeightRequest" Value="52" />
            </Style>

            <!-- Entry moderno -->
            <Style x:Key="ModernEntry" TargetType="Entry">
                <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
                <Setter Property="PlaceholderColor" Value="{StaticResource TextMuted}" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="HeightRequest" Value="56" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
            </Style>

            <!-- Label título grande -->
            <Style x:Key="LabelTitle" TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="HorizontalOptions" Value="Center" />
            </Style>

            <!-- Label subtítulo -->
            <Style x:Key="LabelSubtitle" TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="HorizontalOptions" Value="Center" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
