<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.MAUI.Controls"
             x:Class="QRAsistencia.MAUI.Pages.EleccionPage"
             Title="Asistencia ITES"
             BackgroundColor="#263238">

    <!-- Vista principal: dos botones -->
    <Grid x:Name="MainView"
          RowDefinitions="*,Auto,Auto,*"
          Padding="32">

        <Button x:Name="BtnTomar"
                Grid.Row="1"
                Text="Tomar Asistencia"
                FontSize="30"
                BackgroundColor="#4FC3F7"
                TextColor="Black"
                CornerRadius="10"
                HeightRequest="80"
                Margin="0,0,0,24"
                Clicked="OnTomarClicked" />

        <Button x:Name="BtnMisAsistencias"
                Grid.Row="2"
                Text="Mis Asistencias"
                FontSize="24"
                BackgroundColor="#4FC3F7"
                TextColor="Black"
                CornerRadius="10"
                HeightRequest="70"
                Clicked="OnMisAsistenciasClicked" />
    </Grid>

    <!-- Escáner QR (visible solo al escanear) -->
    <zxing:CameraBarcodeReaderView
        x:Name="BarcodeReader"
        IsVisible="False"
        IsDetecting="False"
        BarcodesDetected="OnBarcodesDetected"
        VerticalOptions="Fill"
        HorizontalOptions="Fill" />

</ContentPage>
