<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.MAUI.Controls"
             x:Class="QRAsistencia.MAUI.Pages.EleccionPage"
             Title=""
             Shell.NavBarIsVisible="False">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#0F172A" Offset="0.0" />
            <GradientStop Color="#1E293B" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid>

        <!-- ═══════════════════════════════════════════
             MENÚ PRINCIPAL
        ═══════════════════════════════════════════ -->
        <ScrollView x:Name="MainView">
            <VerticalStackLayout Padding="28,52,28,36" Spacing="0">

                <!-- Encabezado -->
                <VerticalStackLayout Spacing="4" Margin="0,0,0,32">
                    <Label Text="👋 Bienvenido" TextColor="#94A3B8" FontSize="15" />
                    <Label Text="¿Qué querés hacer hoy?"
                           TextColor="#F8FAFC" FontSize="26" FontAttributes="Bold" />
                </VerticalStackLayout>

                <!-- Tarjeta Tomar Asistencia -->
                <Border BackgroundColor="#1E293B" Stroke="#3B82F640"
                        StrokeThickness="1" StrokeShape="RoundRectangle 20"
                        Padding="28" Margin="0,0,0,20">
                    <Border.Shadow>
                        <Shadow Brush="#3B82F6" Offset="0,4" Radius="20" Opacity="0.2" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="📷" FontSize="40" HorizontalOptions="Start" />
                        <Label Text="Tomar Asistencia"
                               TextColor="#F8FAFC" FontSize="20" FontAttributes="Bold" />
                        <Label Text="Escaneá el código QR del aula para registrar tu asistencia"
                               TextColor="#94A3B8" FontSize="13" />
                        <Button x:Name="BtnTomar" Text="Escanear QR"
                                Style="{StaticResource BtnPrimary}"
                                Margin="0,8,0,0" Clicked="OnTomarClicked" />
                    </VerticalStackLayout>
                </Border>

                <!-- Tarjeta Mis Asistencias -->
                <Border BackgroundColor="#1E293B" Stroke="#10B98140"
                        StrokeThickness="1" StrokeShape="RoundRectangle 20"
                        Padding="28" Margin="0,0,0,28">
                    <Border.Shadow>
                        <Shadow Brush="#10B981" Offset="0,4" Radius="20" Opacity="0.15" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="📋" FontSize="40" HorizontalOptions="Start" />
                        <Label Text="Mis Asistencias"
                               TextColor="#F8FAFC" FontSize="20" FontAttributes="Bold" />
                        <Label Text="Consultá el historial completo de tus asistencias registradas"
                               TextColor="#94A3B8" FontSize="13" />
                        <Button x:Name="BtnMisAsistencias" Text="Ver Historial"
                                BackgroundColor="#10B981" TextColor="White"
                                FontSize="16" FontAttributes="Bold"
                                CornerRadius="14" HeightRequest="56" Margin="0,8,0,0"
                                Clicked="OnMisAsistenciasClicked">
                            <Button.Shadow>
                                <Shadow Brush="#10B981" Offset="0,4" Radius="12" Opacity="0.4" />
                            </Button.Shadow>
                        </Button>
                    </VerticalStackLayout>
                </Border>

                <!-- Footer -->
                <Label Text="ITES · Sistema de Asistencia QR"
                       TextColor="#475569" FontSize="12" HorizontalOptions="Center" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- ═══════════════════════════════════════════
             ESCÁNER QR
        ═══════════════════════════════════════════ -->
        <AbsoluteLayout x:Name="ScannerView" IsVisible="False">

            <!-- Cámara a pantalla completa (FONDO) -->
            <zxing:CameraBarcodeReaderView
                x:Name="BarcodeReader"
                IsDetecting="False"
                BarcodesDetected="OnBarcodesDetected"
                AbsoluteLayout.LayoutBounds="0,0,1,1"
                AbsoluteLayout.LayoutFlags="All" />

            <!-- ── Overlay oscuro: tira SUPERIOR ── -->
            <BoxView Color="#CC000000"
                     AbsoluteLayout.LayoutBounds="0,0,1,0.22"
                     AbsoluteLayout.LayoutFlags="All" />

            <!-- ── Overlay oscuro: tira INFERIOR ── -->
            <BoxView Color="#CC000000"
                     AbsoluteLayout.LayoutBounds="0,0.72,1,0.28"
                     AbsoluteLayout.LayoutFlags="All" />

            <!-- ── Overlay oscuro: borde IZQUIERDO (zona central) ── -->
            <BoxView Color="#CC000000"
                     AbsoluteLayout.LayoutBounds="0,0.22,0.08,0.5"
                     AbsoluteLayout.LayoutFlags="All" />

            <!-- ── Overlay oscuro: borde DERECHO (zona central) ── -->
            <BoxView Color="#CC000000"
                     AbsoluteLayout.LayoutBounds="0.92,0.22,0.08,0.5"
                     AbsoluteLayout.LayoutFlags="All" />

            <!-- ── Marco del QR (esquinas) — SIN fondo, solo borde ── -->
            <!-- Esquina superior izquierda -->
            <BoxView Color="#3B82F6" CornerRadius="2"
                     AbsoluteLayout.LayoutBounds="0.08,0.22,0.07,0.004"
                     AbsoluteLayout.LayoutFlags="All" />
            <BoxView Color="#3B82F6" CornerRadius="2"
                     AbsoluteLayout.LayoutBounds="0.08,0.22,0.004,0.055"
                     AbsoluteLayout.LayoutFlags="All" />
            <!-- Esquina superior derecha -->
            <BoxView Color="#3B82F6" CornerRadius="2"
                     AbsoluteLayout.LayoutBounds="0.85,0.22,0.07,0.004"
                     AbsoluteLayout.LayoutFlags="All" />
            <BoxView Color="#3B82F6" CornerRadius="2"
                     AbsoluteLayout.LayoutBounds="0.916,0.22,0.004,0.055"
                     AbsoluteLayout.LayoutFlags="All" />
            <!-- Esquina inferior izquierda -->
            <BoxView Color="#3B82F6" CornerRadius="2"
                     AbsoluteLayout.LayoutBounds="0.08,0.716,0.07,0.004"
                     AbsoluteLayout.LayoutFlags="All" />
            <BoxView Color="#3B82F6" CornerRadius="2"
                     AbsoluteLayout.LayoutBounds="0.08,0.665,0.004,0.055"
                     AbsoluteLayout.LayoutFlags="All" />
            <!-- Esquina inferior derecha -->
            <BoxView Color="#3B82F6" CornerRadius="2"
                     AbsoluteLayout.LayoutBounds="0.85,0.716,0.07,0.004"
                     AbsoluteLayout.LayoutFlags="All" />
            <BoxView Color="#3B82F6" CornerRadius="2"
                     AbsoluteLayout.LayoutBounds="0.916,0.665,0.004,0.055"
                     AbsoluteLayout.LayoutFlags="All" />

            <!-- ── Línea de escaneo animada ── -->
            <BoxView x:Name="LineaEscaneo"
                     Color="#3B82F6" Opacity="0.7"
                     AbsoluteLayout.LayoutBounds="0.08,0.37,0.84,0.002"
                     AbsoluteLayout.LayoutFlags="All" />

            <!-- ── Texto superior ── -->
            <VerticalStackLayout Spacing="6"
                                 AbsoluteLayout.LayoutBounds="0,0,1,0.22"
                                 AbsoluteLayout.LayoutFlags="All"
                                 VerticalOptions="Center"
                                 HorizontalOptions="Center">
                <Label Text="📷  Escanear QR"
                       TextColor="White" FontSize="20" FontAttributes="Bold"
                       HorizontalOptions="Center" />
                <Label Text="Apuntá la cámara al código QR del aula"
                       TextColor="#CBD5E1" FontSize="13"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- ── Instrucción de distancia (debajo del marco) ── -->
            <Label Text="Mantenelo a 15–25 cm de distancia"
                   TextColor="#94A3B8" FontSize="12"
                   HorizontalOptions="Center"
                   AbsoluteLayout.LayoutBounds="0,0.725,1,0.04"
                   AbsoluteLayout.LayoutFlags="All" />

            <!-- ── Indicador procesando (centro) ── -->
            <ActivityIndicator x:Name="ScanLoader"
                               IsRunning="False" IsVisible="False"
                               Color="White"
                               AbsoluteLayout.LayoutBounds="0.5,0.47,60,60"
                               AbsoluteLayout.LayoutFlags="PositionProportional" />

            <!-- ── Botones inferiores: Linterna + Cancelar ── -->
            <Grid ColumnDefinitions="Auto,*,Auto"
                  AbsoluteLayout.LayoutBounds="0,0.82,1,0.18"
                  AbsoluteLayout.LayoutFlags="All"
                  Padding="32,0"
                  VerticalOptions="Center">

                <!-- Linterna -->
                <Border Grid.Column="0"
                        x:Name="BtnLinterna"
                        BackgroundColor="#1E293B"
                        Stroke="#334155" StrokeThickness="1"
                        StrokeShape="RoundRectangle 14"
                        WidthRequest="56" HeightRequest="56">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnLinternaClicked" />
                    </Border.GestureRecognizers>
                    <Label x:Name="LblLinterna" Text="🔦"
                           FontSize="24"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <!-- Estado -->
                <Label x:Name="LblEstado"
                       Grid.Column="1"
                       Text="Buscando QR..."
                       TextColor="#94A3B8" FontSize="13"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />

                <!-- Cancelar -->
                <Button Grid.Column="2"
                        Text="Cancelar"
                        BackgroundColor="#334155"
                        TextColor="White"
                        FontSize="14" FontAttributes="Bold"
                        CornerRadius="14"
                        HeightRequest="52" WidthRequest="110"
                        Clicked="OnCancelarClicked" />
            </Grid>

        </AbsoluteLayout>

    </Grid>
</ContentPage>
