<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="QRAsistencia.MAUI.Pages.MisAsistenciasPage"
             Title=""
             Shell.NavBarIsVisible="False">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#0F172A" Offset="0.0" />
            <GradientStop Color="#1E293B" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid RowDefinitions="Auto,*,Auto"
          Padding="24,52,24,28">

        <!-- ── Encabezado ── -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,24">
            <VerticalStackLayout Grid.Column="0" Spacing="2">
                <Label Text="📋 Historial"
                       TextColor="#94A3B8"
                       FontSize="13" />
                <Label Text="Mis Asistencias"
                       TextColor="#F8FAFC"
                       FontSize="26"
                       FontAttributes="Bold" />
            </VerticalStackLayout>

            <!-- Total de asistencias -->
            <Border Grid.Column="1"
                    x:Name="BadgeTotal"
                    BackgroundColor="#3B82F620"
                    Stroke="#3B82F650"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12"
                    Padding="12,8"
                    VerticalOptions="Center"
                    IsVisible="False">
                <VerticalStackLayout Spacing="0" HorizontalOptions="Center">
                    <Label x:Name="LblTotal"
                           Text="0"
                           TextColor="#3B82F6"
                           FontSize="20"
                           FontAttributes="Bold"
                           HorizontalOptions="Center" />
                    <Label Text="clases"
                           TextColor="#64748B"
                           FontSize="11"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- ── Lista ── -->
        <Grid Grid.Row="1">

            <ActivityIndicator x:Name="Loader"
                               IsRunning="False"
                               IsVisible="False"
                               Color="#3B82F6"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />

            <CollectionView x:Name="ListaAsistencias">

                <!-- Estado vacío -->
                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         Spacing="16"
                                         Padding="40,60">
                        <Label Text="📅"
                               FontSize="56"
                               HorizontalOptions="Center" />
                        <Label Text="Sin asistencias aún"
                               TextColor="#F8FAFC"
                               FontSize="18"
                               FontAttributes="Bold"
                               HorizontalOptions="Center" />
                        <Label Text="Cuando escanees el QR del aula, tus asistencias aparecerán aquí."
                               TextColor="#64748B"
                               FontSize="13"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <!-- Ítem de asistencia -->
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="#1E293B"
                                Stroke="#334155"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 16"
                                Margin="0,0,0,10"
                                Padding="16,14">
                            <Grid ColumnDefinitions="Auto,*,Auto"
                                  ColumnSpacing="14">

                                <!-- Bloque de fecha (día + mes) -->
                                <Border Grid.Column="0"
                                        BackgroundColor="#1E40AF"
                                        Stroke="#3B82F640"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 12"
                                        WidthRequest="52"
                                        HeightRequest="56"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center">
                                    <VerticalStackLayout Spacing="0"
                                                         HorizontalOptions="Center"
                                                         VerticalOptions="Center">
                                        <Label Text="{Binding Dia}"
                                               TextColor="White"
                                               FontSize="22"
                                               FontAttributes="Bold"
                                               HorizontalOptions="Center" />
                                        <Label Text="{Binding MesAnio}"
                                               TextColor="#93C5FD"
                                               FontSize="9"
                                               FontAttributes="Bold"
                                               HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                </Border>

                                <!-- Día de semana + hora -->
                                <VerticalStackLayout Grid.Column="1"
                                                     VerticalOptions="Center"
                                                     Spacing="3">
                                    <Label Text="{Binding DiaSemana}"
                                           TextColor="#F8FAFC"
                                           FontSize="15"
                                           FontAttributes="Bold" />
                                    <Label Text="{Binding Hora}"
                                           TextColor="#64748B"
                                           FontSize="13" />
                                </VerticalStackLayout>

                                <!-- Badge check -->
                                <Border Grid.Column="2"
                                        BackgroundColor="#10B98118"
                                        Stroke="#10B98145"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 20"
                                        WidthRequest="36"
                                        HeightRequest="36"
                                        VerticalOptions="Center"
                                        HorizontalOptions="End">
                                    <Label Text="✓"
                                           TextColor="#10B981"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>
        </Grid>

        <!-- ── Botón Volver ── -->
        <Button x:Name="BtnVolver"
                Grid.Row="2"
                Text="←  Volver"
                Style="{StaticResource BtnSecondary}"
                Margin="0,12,0,0"
                Clicked="OnVolverClicked" />

    </Grid>
</ContentPage>
